{
    "compilerOptions": {
        "target": "ES6",
        "lib": ["es5", "es6"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "sourceMap": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strictPropertyInitialization": false
    },
    "include": ["src/**/*", "src/*"],
    "exclude": ["dist", "node_modules"]
}
