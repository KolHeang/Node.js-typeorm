{
  "dependencies": {
    "@types/express": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemon": "^3.1.9",
    "pg": "^8.14.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "name": "node.js",
  "version": "1.0.0",
  "description": "create api using node.js with typeorm",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon src/index.ts",
    "start:dev": "ts-node src/index.ts",
    "start":  "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs --dataSource ./src/config/database.ts",
    "migration:generate": "npm run typeorm migration:generate ./src/migrations/Migration --timestamp",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:show": "npm run typeorm migration:show",
    "migration:drop": "npm run typeorm migration:drop"
  },
  "author": "",
  "license": "ISC"
}
